    - target: {fileID: 6025971361990300710, guid: 3bf4eb856a3190f408d60515f843324b, type: 3}
      propertyPath: fullText
      value: "Nao\u2026\nYou got lost in the Night.\r\nHere, paths twist and shadows
        erase memories.\r\nLight the candles.\r\nEach of them will guide me back
        to you.\r\nI will guide you\u2026 as long as the light persists.\r\nDon\u2019t
        let the nightmares catch you."
      objectReference: {fileID: 0}
